DATABASE_URL=postgres://nigrani:nigrani@127.0.0.1:5432/nigrani
# >= 32 chars; unset falls back to a dev-only secret with a startup warning.
JWT_SECRET=dev-secret-change-me-change-me!!
BIND_ADDR=127.0.0.1:8080
# Set APP_ENV=production to block default-credential seeding
# (requires SEED_BOOTSTRAP=true to override).
APP_ENV=development
# Snapshot storage (compose runs LocalStack S3 on :4566).
S3_ENDPOINT=http://127.0.0.1:4566
S3_BUCKET=nigrani-snapshots
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=nigrani
AWS_SECRET_ACCESS_KEY=nigrani-secret-key
# AES-256-GCM key for KYC PII at rest: base64 of 32 random bytes.
# Generate: python3 -c 'import os,base64;print(base64.b64encode(os.urandom(32)).decode())'
# Unset → KYC endpoints fail closed (503-style 500).
BIOMETRIC_KEY=replace-me-with-base64-of-32-bytes
